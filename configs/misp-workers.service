[Unit]
Description=MISP Background Workers
Documentation=https://www.misp-project.org/
After=network.target mariadb.service redis-server.service apache2.service
Wants=mariadb.service redis-server.service apache2.service

[Service]
Type=forking
User=www-data
Group=www-data
ExecStart=/var/www/MISP/app/Console/worker/start.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=300

# Security hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/MISP/app/tmp /var/www/MISP/app/files
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=65535
LimitNPROC=512

# Working directory
WorkingDirectory=/var/www/MISP/app

# Environment
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/var/www/MISP/venv/bin"

[Install]
WantedBy=multi-user.target
